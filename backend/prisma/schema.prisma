generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

generator jsonSchema {
  provider = "prisma-json-schema-generator"
  output   = "./json-schema"
  includeRequiredFields = "true"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          Int            @id @default(autoincrement())
  slug        String         @unique
  title       String
  description String
  coverImage  String
  date        DateTime
  location    String?
  gallery     String[]
  highlights  String[]
  palette      String[]
  fontClass    String?
  borderRadius String?        @default("round")
  subscribe    String?
  themeMode    String?        @default("dark")
  agenda       AgendaItem[]
  speakers    EventSpeaker[]
  partners    Partner[]
  faqs        FAQ[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FAQ {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgendaItem {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  time        String
  title       String
  description String?
  speakerName String?
}

model EventSpeaker {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  memberId    Int?
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  name        String?
  role        String?
  photo       String?
  company     String?
  link        String?
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  password    String
  name        String
  role        String     @default("admin")
  permissions String[]   @default([])
  auditLogs   AuditLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName   String
  action     String
  resource   String
  resourceId Int?
  details    String?
  createdAt  DateTime @default(now())
}

model Member {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String
  photo     String?
  bio       String?
  linkedin  String?
  github    String?
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    String
  isActive  Boolean  @default(true)
  isFounder Boolean  @default(false)
  year      Int      @default(2025)
  eventSpeakers EventSpeaker[]
  articles      Article[]
}

model Tutor {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  photo        String?
  subjects     String[]
  bio          String?
  availability String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Content {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  description String?
  content     String
  url         String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String?
  course     String
  semester   Int
  motivation String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SystemConfig {
  key   String @id
  value String
}

enum ProSelRoom {
  SALA_1
  SALA_2
  SALA_3
  SALA_4
}

enum EmailDeliveryStatus {
  pending
  sent
  failed
}

// Fixed configuration + live counter for each ProSel dynamic room/slot.
// Seeded once via migration; bookedCount is only ever changed through a
// guarded conditional update (see proselBookingService) to prevent
// overbooking under concurrent requests.
model ProSelRoomCapacity {
  room                      ProSelRoom @id
  label                     String
  startTime                 String
  endTime                   String
  capacity                  Int
  bookedCount               Int                 @default(0)
  fullNotifiedAt            DateTime?
  fullNotificationStatus    EmailDeliveryStatus @default(pending)
  fullNotificationAttempts  Int                 @default(0)
  updatedAt                 DateTime            @updatedAt
  bookings                  ProSelBooking[]
}

model ProSelBooking {
  id                          Int                 @id @default(autoincrement())
  fullName                    String
  email                       String              @unique
  room                        ProSelRoom
  roomCapacity                ProSelRoomCapacity  @relation(fields: [room], references: [room])
  eventDate                   DateTime
  startTime                   String
  endTime                     String
  candidateEmailStatus        EmailDeliveryStatus @default(pending)
  candidateEmailAttempts      Int                 @default(0)
  adminEmailStatus            EmailDeliveryStatus @default(pending)
  adminEmailAttempts          Int                 @default(0)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  images      String[]
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  images      String[]
  tags        String[]
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  references  String[]

  authorId     Int?
  authorName   String?
  authorMember Member?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  likes        Int      @default(0)
}

model Partner {
  id              Int      @id @default(autoincrement())
  name            String
  imageUrl        String
  websiteUrl      String?
  isLeaguePartner Boolean  @default(true)
  events          Event[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
